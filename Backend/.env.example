PORT=8801
NODE_ENV=development

# AWS DynamoDB Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Optional Custom DynamoDB Table Names (defaults to standard names if omitted)
DYNAMODB_STAFF_TABLE=staff
DYNAMODB_VEHICLES_TABLE=vehicles
DYNAMODB_CLIENTS_TABLE=clients
DYNAMODB_ASSIGNMENTS_TABLE=vehicle_assignments
DYNAMODB_LOGS_TABLE=audit_logs
